{
  "name": "@metacell/geppetto",
  "version": "1.0.0-alpha.0",
  "description": "MetaCell's neuroscience visualization components for React.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaCell/geppetto-meta"
  },
  "keywords": [
    "geppetto",
    "neuroscience",
    "react"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "build:clean": "rm -rf dist",
    "build:dev": "vite build --mode development",
    "build:types": "tsc --emitDeclarationOnly",
    "publish:yalc": "yalc publish --push",
    "watch": "vite build --watch --mode development",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@mui/material": "^9.0.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "flexlayout-react": "^0.8.17",
    "redux": "^5.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@mui/material": "^9.0.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "ami.js": ">=0.33.0",
    "flexlayout-react": "^0.8.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "resolutions": {
    "react": "^19.0.0"
  }
}
